# Struct literals, field access, copies, struct parameters and methods
struct Point {
    x: int;
    y: int;
};

impl Point {
    fn sum(): int {
        return this.x + this.y;
    }
    fn scaled(k: int): Point {
        return Point{x: this.x * k, y: this.y * k};
    }
};

fn manhattan(a: Point, b: Point): int {
    let dx: int = a.x - b.x;
    let dy: int = a.y - b.y;
    if (dx < 0) {
        dx = -dx;
    }
    if (dy < 0) {
        dy = -dy;
    }
    return dx + dy;
}

fn main() {
    let p: Point = Point{x: 1, y: 2};
    p.x = 5;
    let q: Point = p;
    q.y = 10;
    print(p.x);
    print(" ");
    print(p.y);
    print(" ");
    print(q.y);
    print("\n");
    print(p.sum());
    print(" ");
    print(p.scaled(3).sum());
    print(" ");
    print(manhattan(p, Point{x: 0, y: 0}));
    print("\n");
}
