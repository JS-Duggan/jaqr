# Integer arithmetic, truncating /, floor \, power ~, precedence
fn main() {
    print(1 + 2 * 3);
    print(" ");
    print((1 + 2) * 3);
    print(" ");
    print(10 - 4 - 3);
    print(" ");
    print(7 / 2);
    print(" ");
    print(-7 / 2);
    print(" ");
    print(7 \ 2);
    print(" ");
    print(-7 \ 2);
    print("\n");
    print(2 ~ 10);
    print(" ");
    print(2 ~ 3 ~ 2);
    print(" ");
    print(-2 ~ 2);
    print(" ");
    print(-(3 + 4));
    print("\n");
    let a: int = 17;
    let b: int = 5;
    print(a / b);
    print(" ");
    print(a \ b);
    print(" ");
    print(a - (a / b) * b);
    print(" ");
    print(b ~ 3);
    print("\n");
}
