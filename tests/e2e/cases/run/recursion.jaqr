# Direct recursion: linear, tree, tail-style, deep, over arrays/pointers, methods
fn factorial(n: int): int {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

fn fib(n: int): int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn gcd(a: int, b: int): int {
    if (b == 0) {
        return a;
    }
    return gcd(b, a - (a / b) * b);
}

fn depth(n: int): int {
    if (n == 0) {
        return 0;
    }
    return 1 + depth(n - 1);
}

fn sum_from(a: [6]int, i: int): int {
    if (i == 6) {
        return 0;
    }
    return a[i] + sum_from(a, i + 1);
}

fn countdown(p: ->int): int {
    if (<-p == 0) {
        return 0;
    }
    print(<-p);
    <-p = <-p - 1;
    return countdown(p);
}

fn hanoi(n: int, from_peg: int, to_peg: int, via_peg: int): int {
    if (n == 0) {
        return 0;
    }
    let moves: int = hanoi(n - 1, from_peg, via_peg, to_peg);
    print(from_peg);
    print(to_peg);
    print(" ");
    return moves + 1 + hanoi(n - 1, via_peg, to_peg, from_peg);
}

struct Node {
    value: int;
};

impl Node {
    fn triangle(n: int): int {
        if (n == 0) {
            return this.value;
        }
        return n + this.triangle(n - 1);
    }
};

fn main() {
    print(factorial(10));
    print(" ");
    print(fib(20));
    print(" ");
    print(gcd(1071, 462));
    print("\n");

    print(depth(10000));
    print("\n");

    print(sum_from([1, 2, 3, 4, 5, 6], 0));
    print("\n");

    let n: int = 5;
    countdown(@n);
    print(" ");
    print(n);
    print("\n");

    let moves: int = hanoi(3, 1, 3, 2);
    print("= ");
    print(moves);
    print("\n");

    let node: Node = Node{value: 1000};
    print(node.triangle(4));
    print("\n");
}
